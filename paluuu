<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Portfolio</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <header>
        <h1>Welcome to My Portfolio</h1>
        <p>My first project on GitHub 🚀</p>
    </header>

    <main>
        <section class="card">
            <h2>About Me</h2>
            <p>
                Hello! My name is Your Name. I am learning web development
                and programming. This is my first project uploaded to GitHub.
            </p>

            <h2>My Skills</h2>
            <ul>
                <li>HTML</li>
                <li>CSS</li>
                <li>JavaScript</li>
                <li>Python</li>
            </ul>

            <button onclick="showMessage()">Click Me</button>
            <p id="message"></p>
        </section>
    </main>

    <footer>
        <p>© 2026 Your Name | My GitHub Project</p>
    </footer>

    <script>
        function showMessage() {
            document.getElementById("message").textContent =
                "Thanks for visiting my portfolio! 🎉";
        }
    </script>

</body>
</html>
